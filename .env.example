# Same Postgres container as Spendly (database "linkly")
DATABASE_URL="postgresql://spendly:spendly@localhost:5432/linkly?schema=public"

NEXTAUTH_URL="http://localhost:3003"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# GitHub OAuth App: callback http://localhost:3003/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Development only: a "Dev login" button that needs no GitHub app.
# Ignored unless NODE_ENV=development.
ENABLE_DEV_LOGIN="true"
